# Copy to .env for local development. On Render these are set as environment variables.

# Identity and branding
APP_NAME=Foundation
APP_TAGLINE=
APP_ORGANIZATION=Galinsky Labs
APP_BRAND_COLOR=#2f80c8
APP_CONTACT_EMAIL=

# Web
APP_BASE_URL=http://localhost:8000
# APP_SECRET_KEY: required on any public server; generate with: python -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET_KEY=
# APP_REGISTRATION: closed (admins add users) | invite (admins send links) | open (anyone registers)
APP_REGISTRATION=invite
APP_SESSION_DAYS=30
APP_MAX_UPLOAD_MB=50
# APP_TRUST_PROXY: true behind Render or Caddy, so the real client address is used for rate limits
APP_TRUST_PROXY=false

# First administrator, created once on first start when there are no users
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Database: blank = SQLite in data/. Neon: pooled URL here, direct URL below for migrations.
APP_DATABASE_URL=
APP_DATABASE_URL_DIRECT=
# APP_DATA_DIR=./data

# Email: console (prints, keeps copies in data/outbox) | smtp
APP_EMAIL_BACKEND=console
APP_EMAIL_FROM=
APP_SMTP_HOST=smtp.gmail.com
APP_SMTP_PORT=587
APP_SMTP_USER=
APP_SMTP_PASSWORD=
APP_SMTP_STARTTLS=true

# AI (optional): anthropic | mock
APP_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-sonnet-5-5
APP_LLM_MAX_TOKENS=4000
# APP_MONTHLY_BUDGET_USD: AI calls stop for the month at this spend; 0 = no cap
APP_MONTHLY_BUDGET_USD=20

# Background worker: run exactly one per project
APP_RUN_WORKER=true
